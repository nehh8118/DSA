class Solution:
    def bubbleSort(self,arr):
        # code here
        n=len(arr)
        for i in range(n): #to loop thru all the elements in the array
            swapped=False
            for j in range(n-i-1): #to not check already sorted elements
                if arr[j]>arr[j+1]:
                    temp=arr[j]
                    arr[j]=arr[j+1]
                    arr[j+1]=temp
                    swapped=True 
            if swapped==False: #if no swap, then already sorted, so no need to continue the loop
                break

