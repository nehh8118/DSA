class Solution:
    def sortedSquares(self, nums: list[int]) -> list[int]:
        n=len(nums)
        for i in range(n):
            nums[i] = nums[i]**2
        #bubble sort
        for i in range(n):
            swapped = False
            for j in range(n-i-1):
                if nums[j]>nums[j+1]:
                    nums[j], nums[j+1] = nums[j+1], nums[j]
                    swapped = True
            if swapped == False:
                break
        return nums

