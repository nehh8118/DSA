class Solution:
    def pivotIndex(self, nums: list[int]) -> int:
        prefixsum=[0]*len(nums)
        suffixsum=[0]*len(nums)
        for i in range(1, len(nums)): #prefix sum
            prefixsum[i]= prefixsum[i-1] + nums[i-1] 
        for i in range(len(nums)-2, -1, -1): #suffix sum
            suffixsum[i] = suffixsum[i+1] + nums[i+1]
        for i in range(len(nums)): #if the sum at left n right equal at one point, then return that index
            if prefixsum[i]==suffixsum[i]:
                return i
        return -1
            

        #req: Given an array of integers nums, calculate the pivot index of this array. 
        # The pivot index is the index where the sum of all the numbers to the left of the index is equal to the
        # sum of all the numbers to the index's right. 
        # If no such index exists, return -1