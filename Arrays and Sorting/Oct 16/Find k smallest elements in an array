class Solution: 
    def FindKSmallest(self, arr, k):
        n = len(arr)     
       
        for i in range(k):  # Run the loop exactly k times
            minIndex = i
            for j in range(i + 1, n):
                if arr[j] < arr[minIndex]:
                    minIndex = j
            
            # Swap elements
            arr[i], arr[minIndex] = arr[minIndex], arr[i]
            
        return arr[:k]
