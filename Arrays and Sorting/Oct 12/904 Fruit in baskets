class Solution:
    def totalFruit(self, fruits: List[int]) -> int:
        n = len(fruits)
        res = 0
        for i in range(n):
            types = set() #set to store distinct types of fruits
            j = i
            while j < n and (len(types) < 2 or fruits[j] in types): #if the len of set is less than 2 or the fruit is already in the set, we can add it to the basket
                types.add(fruits[j])
                j += 1 #incrementing j to check for next fruit
            res = max(res, j - i) 
        return res