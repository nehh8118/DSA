class Solution:
    def longestSubarray(self, arr, k):  
        # code here
        maxlen=0
        n=len(arr)
        for i in range(n):
            sum=0
            for j in range(i, n):
                sum+=arr[j]
                if sum==k:
                    maxlen=max(maxlen, j-i+1)
        if maxlen==0:
            return 0
        else:
            return maxlen
            
            
    
